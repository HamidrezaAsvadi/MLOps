{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "python-app-inference",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal"
        },
        {
            "name": "go-app-inference",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "cwd": "${workspaceFolder}",
            "args": [
                "--cp",
                "-d"
            ]
        }
    ]
}